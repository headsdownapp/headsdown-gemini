{
  "name": "@headsdown/gemini",
  "version": "0.4.0",
  "description": "HeadsDown availability extension for Gemini CLI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/headsdownapp/headsdown-gemini.git"
  },
  "homepage": "https://github.com/headsdownapp/headsdown-gemini#readme",
  "bugs": {
    "url": "https://github.com/headsdownapp/headsdown-gemini/issues"
  },
  "keywords": [
    "gemini",
    "gemini-cli",
    "mcp",
    "headsdown",
    "availability",
    "focus",
    "ai-agent"
  ],
  "files": [
    "dist",
    "gemini-extension.json",
    "hooks",
    "skills",
    "agents",
    "commands",
    "policies",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts src/hooks/session-start.ts src/hooks/before-agent.ts src/hooks/check-availability.ts src/mcp/server.ts --bundle --platform=node --format=esm --outdir=dist --outbase=src --external:@modelcontextprotocol/sdk",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@headsdown/sdk": "^0.2.14",
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.0",
    "vitest": "^3.1.0"
  }
}
